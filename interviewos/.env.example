# =============================================================
# AMBIENTE LOCAL (copie este arquivo para .env e edite)
# =============================================================

# Banco de dados — SQLite local (não precisa instalar nada)
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# GitHub OAuth (OPCIONAL — sem isso, login funciona em modo demo)
# Criar em: github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="seu-client-id"
GITHUB_CLIENT_SECRET="seu-client-secret"

# Gemini API (OPCIONAL — sem isso, usa respostas de demonstração)
# Obter em: aistudio.google.com/app/apikey
GEMINI_API_KEY="sua-api-key"


# =============================================================
# AMBIENTE PRODUÇÃO (configurar no painel da Vercel)
# =============================================================

# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
